# ===== 服务端配置(在服务器上复制成 .env 后修改) =====
# 服务器上执行:  cp .env.example .env   然后用 nano 编辑
# .env 不会提交到仓库, 也不会被自动更新覆盖, 重启时会自动读取。
#
# 更简单的改口令方式(推荐):  bash deploy.sh key 你的新口令

# 发卡后台口令(务必修改! 不设的话默认是 siyunx-admin, 知道网址的人都能自己发卡)
CARD_KEY=改成你自己的发卡口令

# 服务端口(默认 3000, 一般不用改)
# PORT=3000

# 设为 off 则不生成演示账号和演示卡(正式上线建议 off)
# DEMO=off

# 「一键体验」入口 /try 的开关(与 DEMO 相互独立)
# 打开 /try 会当场建一个独立体验账号, 24 小时后自动清理, 同一 IP 每小时最多 5 个
# 正式上线若不希望对外开放, 设为 off
# TRIAL=off

# ===== 申请通知邮件(可选, 走 EmailJS) =====
# 老师提交「申请激活卡号」后, 自动发一封邮件到站长邮箱。
# 不配置则只在服务器日志里记录, 不影响申请流程。
#
# 配置方式: 在服务器执行 `bash deploy.sh mail emailjs 服务ID 模板ID 公钥`
#
# 收件邮箱(默认 ladyiney25@gmail.com)
# MAIL_TO=ladyiney25@gmail.com

# ---- EmailJS: 邮件版式放在它的后台模板里, 代码只负责传变量 ----
# 1) 注册 https://www.emailjs.com, 添加一个 Service(绑定一个发信邮箱, 如 Gmail);
# 2) 新建 Template, 字段这样填:
#      To Email  = {{to_email}}      Subject  = {{subject}}
#      From Name = {{from_name}}     Reply To = {{reply_to}}
#      正文      = {{text}}   想用系统拼好的 HTML 表格就再写一行 {{{html_content}}}
# 3) 复制 Service ID / Template ID, 以及 Account → General 里的 Public Key;
#    注意 Service ID 形如 service_xxxxxxx, 别把 Service 的「名字」当成 ID;
# 4) 必做: 到 Account → Security 打开 "Allow EmailJS API for non-browser applications",
#    否则服务端(Node)发信会被 403 拒绝(non-browser environments is currently disabled);
# 5) 建议再开启 Strict Mode(限制调用来源), 这时才需要上面的 Private Key。
# EMAILJS_SERVICE_ID=service_xxxxxxx
# EMAILJS_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_PUBLIC_KEY=你的公钥
# EMAILJS_PRIVATE_KEY=你的私钥(开了 Strict Mode 才需要)
#
# 邮件里「发件人」显示的名字(模板里用 {{from_name}})
# MAIL_FROM_NAME=班级喊话系统
#
# 注意: 免费额度 200 封/月, 接口限速 1 封/秒(两条申请挨得太近时, 后一条可能失败并记在日志里)。
# 发信超时(毫秒, 默认 15000, 一般不用改)
# MAIL_TIMEOUT=15000

# 邮件里生成后台入口链接用的站点地址(可选, 不填则按访问者请求头自动推断)
# PUBLIC_BASE_URL=https://callclass.site
