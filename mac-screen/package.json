{
  "name": "class-call-screen",
  "version": "1.0.0",
  "private": true,
  "description": "班级喊话 · 教室演示屏(跨平台 Electron 桌面端, 支持 macOS / Windows, 全屏接收并播报通知)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir && electron-builder --win portable",
    "dist:mac": "electron-builder --mac dir",
    "dist:win": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "xyz.siyunx.call.screen",
    "productName": "班级喊话演示屏",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "error.html",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        "portable"
      ],
      "arch": [
        "x64"
      ]
    }
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^26.15.3"
  }
}
